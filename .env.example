# ─────────────────────────────────────────────────────────────
# My Atlas — variáveis de ambiente
# Copie para .env.local (dev) e cadastre as mesmas na Vercel.
# Sem as duas primeiras, o app abre automaticamente em MODO DEMO.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# (Opcional) Trava extra no callback do OAuth: só esses e-mails entram.
# A trava definitiva fica no banco (tabela app_allowed_emails no schema.sql).
ALLOWED_EMAILS=voce@gmail.com,esposa@gmail.com
