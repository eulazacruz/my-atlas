<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/w_bg">
<TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Água" android:textSize="10.5sp" android:textColor="@color/w_muted" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:textAllCaps="true" android:letterSpacing="0.12" android:includeFontPadding="false" />
<TextView android:id="@+id/big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0L" android:textSize="26sp" android:textColor="@color/w_text" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:includeFontPadding="false" android:layout_marginTop="8dp"/>
